DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=sgpa
DB_SYNCHRONIZE=false

# Autorización persistente para migraciones automáticas en npm run start:dev.
# Complete una sola vez estos datos con la identidad real del MySQL local.
SGPA_RUNTIME_ENV=development
SGPA_TEST_MODE=false
SGPA_AUTO_MIGRATE_DEV=false
SGPA_AUTO_MIGRATE_DATABASE=sgpa
SGPA_AUTO_MIGRATE_HOST=localhost
SGPA_AUTO_MIGRATE_PORT=3306
SGPA_AUTO_MIGRATE_DATADIR=
SGPA_AUTO_MIGRATE_SERVER_UUID=

PORT=3000
NODE_ENV=development

JWT_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_REDIRECT_URI=
# Configure la URL HTTPS real antes de enviar invitaciones a usuarios remotos.
# En desarrollo local puede omitirse para usar http://127.0.0.1:<PORT>.
SGPA_INVITATION_BASE_URL=
# Clave hex de 32 bytes, generada y almacenada fuera del repositorio.
SGPA_INVITATION_ENCRYPTION_KEY=
# Activar solo después de aplicar la migración y revisar el destino.
SGPA_INVITATION_OUTBOX_ENABLED=false
