DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=sgpa
DB_SYNCHRONIZE=false

# npm run start:dev aplica solamente cambios aditivos del esquema.
# La sincronización completa de TypeORM permanece desactivada para proteger datos.
SGPA_TEST_MODE=false
SGPA_RUNTIME_ENV=development
# Autorizar la base y el servidor MySQL local de esta computadora.
SGPA_AUTO_MIGRATE_DEV=false
SGPA_AUTO_MIGRATE_DATABASE=
SGPA_AUTO_MIGRATE_HOST=
SGPA_AUTO_MIGRATE_PORT=
SGPA_AUTO_MIGRATE_DATADIR=
SGPA_AUTO_MIGRATE_SERVER_UUID=
# Activar después de configurar identidad y respaldo.
SGPA_AUTO_SCHEMA_SYNC_DEV=false
SGPA_SCHEMA_BACKUP_DIR=
SGPA_MYSQLDUMP_PATH=

PORT=3000
NODE_ENV=development

JWT_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_REDIRECT_URI=
# Configure la URL HTTPS real antes de enviar invitaciones a usuarios remotos.
# En desarrollo local puede omitirse para usar http://127.0.0.1:<PORT>.
SGPA_INVITATION_BASE_URL=
# Clave hex de 32 bytes, generada y almacenada fuera del repositorio.
SGPA_INVITATION_ENCRYPTION_KEY=
# Activar solo después de aplicar la migración y revisar el destino.
SGPA_INVITATION_OUTBOX_ENABLED=false
